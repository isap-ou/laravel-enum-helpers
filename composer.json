{
  "name": "isap-ou/laravel-enum-helpers",
  "description": "Helpers for native PHP enums in Laravel: translatable labels, value collections for migrations, MySQL enum column sync, and export to JavaScript.",
  "keywords": [
    "laravel",
    "enum",
    "enums",
    "php-enum",
    "native-enum",
    "enum-labels",
    "enum-translation",
    "migration",
    "mysql-enum",
    "javascript",
    "filament",
    "laravel-boost"
  ],
  "type": "library",
  "require": {
    "illuminate/contracts": "^9|^10|^11|^12|^13"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "IsapOu\\EnumHelpers\\": "src/"
    }
  },
  "authors": [
    {
      "name": "ISAP OU",
      "email": "contact@isap.me"
    }
  ],
  "extra": {
    "laravel": {
      "providers": [
        "IsapOu\\EnumHelpers\\ServiceProvider"
      ]
    }
  }
}
